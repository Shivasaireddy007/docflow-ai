{
  "Comment": "docflow: a receipt from upload to decision. Model steps retry with backoff; failures are recorded and sent to the dead-letter queue.",
  "StartAt": "Prepare",
  "States": {
    "Prepare": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": { "FunctionName": "${prepare_arn}", "Payload.$": "$" },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.TooManyRequestsException", "Lambda.SdkClientException"],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 3,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "Failed?" }],
      "Next": "Already processed?"
    },
    "Already processed?": {
      "Type": "Choice",
      "Choices": [{ "Variable": "$.skip", "BooleanEquals": true, "Next": "Done" }],
      "Default": "OCR"
    },
    "OCR": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": { "FunctionName": "${ocr_arn}", "Payload.$": "$" },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": ["ModelError", "ModelBusy", "Lambda.ServiceException", "Lambda.TooManyRequestsException", "States.Timeout"],
          "IntervalSeconds": ${model_retry_seconds},
          "BackoffRate": 2,
          "MaxAttempts": 4,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "Failed?" }],
      "Next": "Extract fields"
    },
    "Extract fields": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": { "FunctionName": "${extract_arn}", "Payload.$": "$" },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": ["ModelError", "ModelBusy", "Lambda.ServiceException", "Lambda.TooManyRequestsException", "States.Timeout"],
          "IntervalSeconds": ${model_retry_seconds},
          "BackoffRate": 2,
          "MaxAttempts": 4,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "Failed?" }],
      "Next": "Decide"
    },
    "Decide": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": { "FunctionName": "${decide_arn}", "Payload.$": "$" },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.TooManyRequestsException", "Lambda.SdkClientException"],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 3,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "Failed?" }],
      "Next": "Done"
    },
    "Failed?": {
      "Type": "Choice",
      "Comment": "A document claimed by Prepare is marked failed so it can be retried; an unusable upload has no record.",
      "Choices": [{ "Variable": "$.pk", "IsPresent": true, "Next": "Mark failed" }],
      "Default": "Send to dead-letter queue"
    },
    "Mark failed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${results_table}",
        "Key": { "pk": { "S.$": "$.pk" } },
        "UpdateExpression": "SET #s = :failed, #e = :error",
        "ExpressionAttributeNames": { "#s": "status", "#e": "error" },
        "ExpressionAttributeValues": { ":failed": { "S": "failed" }, ":error": { "S.$": "$.error.Error" } }
      },
      "ResultPath": null,
      "Next": "Send to dead-letter queue"
    },
    "Send to dead-letter queue": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sqs:sendMessage",
      "Parameters": { "QueueUrl": "${dead_letter_queue_url}", "MessageBody.$": "$" },
      "ResultPath": null,
      "Next": "Failed"
    },
    "Failed": { "Type": "Fail", "Error": "DocumentFailed", "Cause": "See the dead-letter queue message." },
    "Done": { "Type": "Succeed" }
  }
}
